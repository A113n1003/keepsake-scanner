{
  "name": "keepsake-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A privacy-first macOS app for scanning, separating, and archiving printed photographs.",
  "license": "MIT",
  "author": "Keepsake Scanner contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A113n1003/keepsake-scanner.git"
  },
  "bugs": {
    "url": "https://github.com/A113n1003/keepsake-scanner/issues"
  },
  "homepage": "https://github.com/A113n1003/keepsake-scanner#readme",
  "main": "electron/main.cjs",
  "scripts": {
    "native:build": "swift build -c release --package-path native",
    "native:prepare": "npm run native:build && node scripts/prepare-native.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "dev": "npm run native:build && concurrently -k \"npm:dev:ui\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:ui": "vite build",
    "build": "npm run native:prepare && npm run build:ui",
    "dist": "npm run build && electron-builder --mac dmg zip && npm run artifact:check",
    "dist:dir": "npm run build && electron-builder --mac dir && npm run artifact:check",
    "artifact:check": "node scripts/check-artifact-privacy.mjs",
    "test:native": "npm run native:build && native/.build/release/PhotoScannerNative self-test resources/demo-flatbed.png",
    "test": "npm run test:native && npm run build:ui",
    "lint": "eslint .",
    "i18n:check": "node scripts/check-i18n.mjs",
    "privacy:check": "node scripts/check-privacy.mjs",
    "check": "npm run privacy:check && npm run i18n:check && npm run lint && npm test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "app.keepsakescanner.desktop",
    "productName": "Keepsake Scanner",
    "artifactName": "Keepsake-Scanner-${version}-${arch}.${ext}",
    "copyright": "Copyright © 2026 Keepsake Scanner contributors",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "electronLanguages": [
      "en",
      "zh_CN"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "build/native/PhotoScannerNative",
        "to": "native/PhotoScannerNative"
      },
      {
        "from": "resources/demo-flatbed.png",
        "to": "demo-flatbed.png"
      }
    ],
    "mac": {
      "category": "public.app-category.photography",
      "icon": "build/app-icon.png",
      "minimumSystemVersion": "14.0",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": true,
      "extendInfo": {
        "NSHumanReadableCopyright": "Copyright © 2026 Keepsake Scanner contributors",
        "NSDocumentsFolderUsageDescription": "Keepsake Scanner saves scanned photos only in a folder you choose.",
        "NSDesktopFolderUsageDescription": "Keepsake Scanner saves scanned photos only in a folder you choose."
      }
    },
    "dmg": {
      "title": "Keepsake Scanner",
      "backgroundColor": "#f4f4f0",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
